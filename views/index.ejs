  <%# Modal de login/registro (extraído a partial para mantener este archivo limpio) %>
  <%- include('partials/auth-modal') %>

  <%# ══════════════════════════════════════════════════
      SCRIPTS
      Orden importante: primero librerías externas,
      luego módulos propios de menor a mayor dependencia.
      config.js → map.js → tiempo.js → ui.js → auth.js
  ══════════════════════════════════════════════════ %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="https://unpkg.com/leaflet.heat@0.2.0/dist/leaflet-heat.js"></script>
  <script src="https://unpkg.com/leaflet.markercluster@1.4.1/dist/leaflet.markercluster.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>

  <script src="/javascripts/config.js"></script>
  <script src="/javascripts/map.js"></script>
  <script src="/javascripts/tiempo.js"></script>
  <script src="/javascripts/ui.js"></script>
  <script src="/javascripts/auth.js"></script>

 <script>
    /* ══════════════════════════════════════════════════════════════
        SCRIPTS INLINE — Comportamientos globales de la página
        Separados aquí para no contaminar los módulos JS.
     ══════════════════════════════════════════════════════════════ */

    /* 1. HEADER DINÁMICO EN SCROLL
       El header empieza transparente y se vuelve sólido al bajar.
       Solo funciona en la sección de Inicio porque las demás no hacen scroll. */
    const appHeader = document.getElementById('appHeader');
    const secInicio = document.getElementById('secInicio');

    function updateHeaderOnScroll() {
      appHeader.classList.toggle('header-solid', (secInicio.scrollTop || 0) > 60);
    }
    secInicio.addEventListener('scroll', updateHeaderOnScroll, { passive: true });

    /* 2. WRAPPER DE goToSection
       Interceptamos la función original para añadir tres efectos:
       - Control de acceso (Auth-wall) para bloquear secciones premium si no hay sesión
       - Solidificar el header al salir de Inicio
       - Lanzar el motor de animaciones reveal en la nueva sección */
    const _origGoTo = window.goToSection;
    window.goToSection = function(name) {
      
      // Definimos los nombres de las pestañas que queremos proteger
      const rutasProtegidas = ['estadisticas', 'noticias', 'mapas'];
      
      // Si el usuario intenta entrar a una sección protegida y NO ha iniciado sesión...
      if (rutasProtegidas.includes(name) && window.HV_Auth && !window.HV_Auth.isLogged()) {
        window.doLogin(); // Abrimos el modal de login de forma automática
        
        // Colocamos el texto de aviso en la caja de mensajes del modal
        const msgBox = document.getElementById('authMsg');
        if (msgBox) {
          msgBox.textContent = 'Inicia sesión para acceder a las funciones avanzadas.';
          msgBox.className = 'auth-msg show error';
        }
        return; // Cortamos la ejecución aquí para impedir que se cambie de pestaña
      }

      // Si está logueado o la sección es pública, continúa la navegación normal
      if (typeof _origGoTo === 'function') _origGoTo(name);
      appHeader.classList.toggle('header-solid', name !== 'inicio');
      if (name === 'inicio') setTimeout(updateHeaderOnScroll, 50);
      setTimeout(initReveal, 80);
    };

    /* 3. MOTOR DE ANIMACIONES REVEAL (fade-in al scroll)
       IntersectionObserver detecta cuándo cada elemento .reveal
       entra en el viewport y le añade la clase .revealed. */
    const revealObs = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('revealed');
          revealObs.unobserve(e.target); // solo se anima una vez
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

    function initReveal() {
      document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach(el => {
        if (!el.classList.contains('revealed')) revealObs.observe(el);
      });
    }
    document.addEventListener('DOMContentLoaded', initReveal);

    /* 4. ANIMACIÓN DE CONTADORES (efecto "ruleta" de números)
       Se usa para los KPIs del hero y la marquesina. */
    function animateCount(el, target, suffix, dur) {
      const isFloat = String(target).includes('.');
      const t0 = performance.now();
      (function step(now) {
        const p = Math.min((now - t0) / dur, 1);
        const e = 1 - Math.pow(1 - p, 3); // ease-out cúbico
        el.textContent = (isFloat ? (target * e).toFixed(1) : Math.floor(target * e)) + (suffix || '');
        if (p < 1) requestAnimationFrame(step);
      })(t0);
    }

    /* Espera a que renderLanding esté disponible para poder envolverla.
       Es necesario porque ui.js puede tardar un momento en declarar la función. */
    const probe = setInterval(() => {
      if (typeof renderLanding === 'function') {
        clearInterval(probe);
        const orig = renderLanding;
        window.renderLanding = function() {
          orig();
          setTimeout(window._runLandingCounters, 300);
        };
      }
    }, 100);
  </script>

</body>
</html>
